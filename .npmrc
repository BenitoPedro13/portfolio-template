# Install a flat node_modules instead of pnpm's symlinked layout.
#
# Next's file tracer does not follow pnpm's symlinks into `.pnpm`, so sharp's
# native libvips binaries were left out of the serverless bundle and every
# request touching Payload failed with ERR_DLOPEN_FAILED on Vercel. A hoisted
# layout is what the tracer expects.
node-linker=hoisted
