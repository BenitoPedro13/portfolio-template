# Copy to .env for local development, and set the same keys in your Vercel
# project (Settings → Environment Variables) for Production and Preview.

# --- Required ---------------------------------------------------------------

# Postgres connection string.
#
# On Supabase, use the TRANSACTION pooler (port 6543) for anything serverless.
# Copy it from: Project → Connect → Transaction pooler.
#
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# Two traps worth knowing about:
#
#   * The direct host (db.<ref>.supabase.co) is IPv6-only. It works on your
#     machine and fails on every Vercel function, which have no IPv6 route.
#   * The session pooler (port 5432) pins one server connection per client and
#     is capped at 15, so it dies with EMAXCONNSESSION once functions scale.
#     It is still the right choice for one-off migrations and seeding.
#
# If the password contains @ : / ? # or a space, URL-encode it, otherwise the
# host is parsed wrong and you get "getaddrinfo ENOTFOUND <fragment>".
DATABASE_URL=

# Signs Payload's auth tokens. Any long random string; changing it logs
# everyone out. Generate one with: openssl rand -hex 32
PAYLOAD_SECRET=

# --- Localisation -----------------------------------------------------------

# Comma-separated locale codes. The first is the fallback if
# PORTFOLIO_DEFAULT_LOCALE is unset or not in the list.
# Changing this changes the URL structure (/pt, /en, …) and the locales
# available in the admin. Run `pnpm generate:types` afterwards.
PORTFOLIO_LOCALES=pt,en
PORTFOLIO_DEFAULT_LOCALE=pt

# --- Uploads (production) ---------------------------------------------------

# Required on Vercel: serverless filesystems are wiped between requests, so
# without this any image you upload in /admin disappears.
#
# Create a Blob store in the Vercel dashboard (Storage → Create → Blob) and
# connect it to the project; Vercel injects this token automatically.
# Leave it unset locally to store uploads in ./media instead.
BLOB_READ_WRITE_TOKEN=
